# Canonical production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.getbiu.app

# Optional PostHog website analytics. Leave the key empty to disable tracking.
# Use the public project key, not a personal API key.
# For EU projects, use https://eu.i.posthog.com instead.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Shared chat links (/shared-chat/:token).
# biu API base including /api/v1, same value as EXPO_PUBLIC_API_URL in biu-so.
NEXT_PUBLIC_BIU_API_URL=
# Public app identity for Universal Links / App Links. Association files return
# 404 until these are set. Fingerprints: Play Console > App integrity, comma-separated.
NEXT_PUBLIC_APPLE_TEAM_ID=
NEXT_PUBLIC_IOS_APP_STORE_ID=
NEXT_PUBLIC_ANDROID_CERT_SHA256=

# Optional destinations. Components hide links that are not configured.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_WAITLIST_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_REDDIT_URL=
NEXT_PUBLIC_X_URL=

# Server-only Google Sheets credentials for beta access and data deletion requests.
# Share the target Sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as an editor.
# The Sheet must contain tabs named "Beta Requests" and "Data Deletion Requests".
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
