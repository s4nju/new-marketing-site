{
  "name": "biu-marketing-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "images:hero": "node scripts/optimize-hero.mjs",
    "start": "next start",
    "lint": "next lint",
    "dev:vinext": "vite dev --mode staging --port 3001",
    "build:vinext": "vite build --mode staging",
    "build:cloudflare": "vite build --mode production",
    "typecheck:vinext": "tsc --project tsconfig.cloudflare.json --noEmit",
    "start:vinext": "vite preview --mode staging",
    "deploy:vinext": "npm run deploy:cloudflare",
    "deploy:cloudflare": "vinext-cloudflare deploy --env production"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vinext/cloudflare": "^1.3.4",
    "google-auth-library": "^11.0.0",
    "next": "^16.4.6",
    "posthog-js": "^1.433.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "vinext": "^1.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.29",
    "postcss": "8.5.25",
    "typescript": "^5",
    "vite": "^8.3.7",
    "vite-css-modules": "^1.16.1"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5"
  },
  "type": "module"
}
